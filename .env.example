# SMART on FHIR client ID registered with the EHR (or vendor sandbox).
VITE_SMART_CLIENT_ID=

# VITE_SMART_PRIVATE_KEY_JWK is set → SMART Backend Services (client credentials) path:
#   token exchange happens in-page, client is stored, navigates to /app
# VITE_SMART_PRIVATE_KEY_JWK is empty/absent → Authorization Code path:
#   smartLaunch() redirects to the EHR, CallbackPage handles the return
VITE_SMART_PRIVATE_KEY_JWK=

# Default FHIR server base URL, used by /dev and /patient when no `iss` launch param is present.
VITE_FHIR_ISS=

# Base URL of a running shc-services instance. In dev, the Vite proxy also forwards
# /api/shc -> http://localhost:3000/shc.
VITE_SHC_CREATE_URL=https://shc-services.azurewebsites.net

# Azure Entra ID app registration used to obtain the bearer token shc-services expects.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_SECRET=

# OAuth scope requested for the shc-services token.
VITE_SHC_SCOPE=api://<shc-services-client-id>/.default

# URL of the PDF-generation function used to render the Personal Health Plan PDF
# (a separate deployed service, not part of this repo).
VITE_PDF_FUNCTION_URL=
