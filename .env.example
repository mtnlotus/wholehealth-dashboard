VITE_SMART_CLIENT_ID=
                            
# VITE_SMART_PRIVATE_KEY_JWK is set → Client Credentials path: token exchange happens in-page, client is stored, navigates to /app                         
# VITE_SMART_PRIVATE_KEY_JWK is empty/absent → Authorization Code path: smartLaunch() redirects to the EHR, CallbackPage handles the return    
VITE_SMART_PRIVATE_KEY_JWK=

VITE_FHIR_ISS=
VITE_SHC_CREATE_URL=https://shc-create.azurewebsites.net
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_SECRET=
VITE_SHC_SCOPE=api://<shc-create-client-id>/.default
VITE_PDF_FUNCTION_URL=
